{
  "limits": {
    "maxBodyBytes": 65536,
    "maxFrameBytes": 65540,
    "maxDepth": 8,
    "maxObjectKeys": 16,
    "maxArrayItems": 32,
    "maxStringBytes": 256,
    "minTimeoutMs": 1,
    "maxTimeoutMs": 10000,
    "handshakeTimeoutMs": 5000,
    "maxOutstandingRequests": 4,
    "maxOrdinaryRequests": 3,
    "maxCancelRequests": 1,
    "maxQueuedFrames": 4,
    "maxQueuedBytes": 262160,
    "maxRequestsPerConnection": 256,
    "maxStreams": 0
  },
  "definitions": {
    "uuid": {"type": "uuid"},
    "generation": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "attemptOutcome": {"type": "string", "enum": ["success", "failure", "cancelled"]},
    "capabilities": {"type": "array", "items": {"type": "string"}, "const": ["topology-v1"]},
    "caseID": {
      "type": "string",
      "enum": ["ownZoneReadWrite", "mainCanaryRead", "mainCanaryWrite", "externalCanaryRead", "externalCanaryWrite", "mainCanarySymlinkRead", "externalCanarySymlinkRead", "foreignGroupCanaryRead", "foreignGroupCanaryWrite", "foreignGroupCanarySymlinkRead", "inboundListen"]
    },
    "errorCode": {
      "type": "string",
      "enum": ["versionMismatch", "handshakeRequired", "unknownMethod", "invalidParams", "busy", "cancelled", "timeout", "unavailable", "internal"]
    }
  },
  "envelopes": {
    "request": {
      "type": "object",
      "fields": {
        "kind": {"type": "string", "const": "request"},
        "id": {"ref": "uuid"},
        "method": {"type": "string"},
        "timeoutMs": {"type": "integer", "minimumLimit": "minTimeoutMs", "maximumLimit": "maxTimeoutMs"},
        "params": {"type": "object"}
      }
    },
    "result": {
      "type": "object",
      "fields": {
        "kind": {"type": "string", "const": "result"},
        "id": {"ref": "uuid"},
        "result": {"type": "object"}
      }
    },
    "error": {
      "type": "object",
      "fields": {
        "kind": {"type": "string", "const": "error"},
        "id": {"ref": "uuid"},
        "code": {"ref": "errorCode"}
      }
    }
  },
  "methods": {
    "hello": {
      "params": {"type": "object", "fields": {"major": {"type": "integer"}, "minor": {"type": "integer"}, "capabilities": {"ref": "capabilities"}}},
      "result": {"type": "object", "fields": {"major": {"type": "integer", "const": 1}, "minor": {"type": "integer", "const": 1}, "capabilities": {"ref": "capabilities"}}}
    },
    "topology.runtime": {
      "params": {"type": "object", "fields": {}},
      "result": {"type": "object", "fields": {"sdkImported": {"type": "boolean"}, "cliInitialized": {"type": "boolean"}, "architecture": {"type": "string", "enum": ["arm64", "x86_64"]}}}
    },
    "topology.prepare": {
      "params": {"type": "object", "fields": {"runID": {"ref": "uuid"}}},
      "result": {"type": "object", "fields": {"prepared": {"type": "boolean"}}}
    },
    "topology.identity": {
      "params": {"type": "object", "fields": {"runID": {"ref": "uuid"}}},
      "result": {"type": "object", "fields": {"bridgePID": {"type": "integer", "minimum": 1, "maximum": 2147483647}, "pythonPID": {"type": "integer", "minimum": 1, "maximum": 2147483647}}}
    },
    "topology.probe": {
      "params": {"type": "object", "fields": {"runID": {"ref": "uuid"}, "caseID": {"ref": "caseID"}}},
      "result": {
        "type": "object",
        "fields": {
          "outcome": {"type": "string", "enum": ["allowed", "denied", "inconclusive"]},
          "reason": {"type": "string", "enum": ["none", "permissionDenied", "missingFixture", "controlFailed", "unexpectedErrno"]},
          "syscallObserved": {"type": "boolean"},
          "syscallResult": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
          "errno": {"type": "integer", "minimum": 0, "maximum": 2147483647},
          "beganAtNs": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
          "endedAtNs": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
        },
        "syscallObservation": {"observed": "syscallObserved", "result": "syscallResult", "errno": "errno", "began": "beganAtNs", "ended": "endedAtNs"}
      }
    },
    "topology.cleanup": {
      "params": {"type": "object", "fields": {"runID": {"ref": "uuid"}}},
      "result": {"type": "object", "fields": {"absent": {"type": "boolean"}}}
    },
    "topology.wait": {
      "params": {"type": "object", "fields": {"durationMs": {"type": "integer", "minimum": 1, "maximum": 5000}}},
      "result": {"type": "object", "fields": {"elapsed": {"type": "boolean"}}}
    },
    "topology.attemptPrepare": {
      "params": {"type": "object", "fields": {"runID": {"ref": "uuid"}, "paperID": {"ref": "uuid"}, "generation": {"ref": "generation"}, "correlationID": {"ref": "uuid"}}},
      "result": {"type": "object", "fields": {"prepared": {"type": "boolean"}}}
    },
    "topology.attemptTerminal": {
      "params": {"type": "object", "fields": {"runID": {"ref": "uuid"}, "paperID": {"ref": "uuid"}, "generation": {"ref": "generation"}, "correlationID": {"ref": "uuid"}, "outcome": {"ref": "attemptOutcome"}}},
      "result": {"type": "object", "fields": {"absent": {"type": "boolean"}}}
    },
    "topology.attemptRecover": {
      "params": {"type": "object", "fields": {"runID": {"ref": "uuid"}}},
      "result": {"type": "object", "fields": {"absent": {"type": "boolean"}}}
    },
    "cancel": {
      "params": {"type": "object", "fields": {"targetID": {"ref": "uuid"}}},
      "result": {"type": "object", "fields": {"accepted": {"type": "boolean"}}}
    }
  }
}
